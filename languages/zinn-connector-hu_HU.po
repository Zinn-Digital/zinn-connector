msgid "Zinn® Connector"
msgstr "Zinn® Connector"

#. Plugin URI of the plugin
#: zinn-connector.php
msgid "https://zinndigital.com/wordpress-plugins/zinn-connector"
msgstr "https://zinndigital.com/wordpress-plugins/zinn-connector"

#. Description of the plugin
#: zinn-connector.php
msgid "Connects this WordPress site to Zinn Digital® so scheduled articles can be published to it. Paste a pairing code from your Zinn® dashboard and the plugin sets up its own credential — nothing is copied by hand."
msgstr "Összeköti ezt a WordPress webhelyet a Zinn Digital® szolgáltatással, hogy az ütemezett cikkek publikálhatók legyenek rajta. Illesszen be egy párosítási kódot a Zinn® vezérlőpultjáról, és a bővítmény beállítja a saját hitelesítő adatait – semmit sem kell kézzel másolni."

#. Author of the plugin
#: zinn-connector.php
msgid "Neil Lock — CEO, Zinn Digital® Ltd"
msgstr "Neil Lock — CEO, Zinn Digital® Ltd"

#. Author URI of the plugin
#: zinn-connector.php
msgid "https://zinndigital.com"
msgstr "https://zinndigital.com"

#: includes/class-zinn-connector-backup.php:168
msgid "This site's PHP cannot create archives, so a backup could not be made."
msgstr "Ennek a webhelynek a PHP-je nem tud archívumokat létrehozni, ezért a biztonsági mentést nem lehetett elkészíteni."

#: includes/class-zinn-connector-backup.php:176
msgid "Could not create a temporary file."
msgstr "Nem sikerült ideiglenes fájl létrehozni."

#: includes/class-zinn-connector-backup.php:201
msgid "This site's files could not be archived."
msgstr "Ennek a webhelynek a fájljait nem sikerült archiválni."

#: includes/class-zinn-connector-backup.php:312
msgid "The archive could not be read back."
msgstr "Az archívumot nem sikerült visszaolvasni."

#: includes/class-zinn-connector-backup.php:329
msgid "The backup could not be uploaded."
msgstr "A biztonsági mentést nem sikerült feltölteni."

#: includes/class-zinn-connector-backup.php:334
msgid "The backup upload was rejected."
msgstr "A biztonsági mentés feltöltése elutasításra került."

#: includes/class-zinn-connector-claim.php:50
msgid "This WordPress user cannot publish posts, so a connection made now could not publish either. Sign in as a user who can, and try again."
msgstr "Ez a WordPress-felhasználó nem tud bejegyzéseket közzétenni, így a most létrehozott kapcsolat sem tudna közzétenni. Jelentkezzen be egy olyan felhasználóként, aki képes erre, és próbálja újra."

#: includes/class-zinn-connector-claim.php:57
msgid "Application passwords are turned off on this site, so we cannot create a credential. Ask your host to enable them, or connect the site with a password you create yourself in your Zinn Digital® dashboard."
msgstr "Az alkalmazásjelszavak ki vannak kapcsolva ezen a webhelyen, így nem tudunk hitelesítő adatot létrehozni. Kérje meg a tárhelyszolgáltatóját, hogy engedélyezze ezeket, vagy csatlakoztassa a webhelyet egy olyan jelszóval, amelyet saját maga hoz létre a Zinn Digital® vezérlőpultján."

#: includes/class-zinn-connector-claim.php:69
msgid "WordPress would not create a credential for this site. Nothing has been sent anywhere."
msgstr "A WordPress nem tudott hitelesítő adatot létrehozni ehhez a webhelyhez. Semmi sem lett elküldve sehová."

#: includes/class-zinn-connector-claim.php:100
msgid "We could not reach Zinn Digital® from this site. Nothing was connected, and the credential we made has been removed. Check the site can make outgoing requests, and try again."
msgstr "Nem tudtuk elérni a Zinn Digital® szolgáltatást erről a webhelyről. Semmi sem csatlakozott, és a létrehozott hitelesítő adatot eltávolítottuk. Ellenőrizze, hogy a webhely képes-e kimenő kéréseket indítani, majd próbálja újra."

#: includes/class-zinn-connector-claim.php:116
msgid "Zinn Digital® did not accept that pairing code. Nothing was connected. Generate a fresh code in your dashboard and try again."
msgstr "A Zinn Digital® nem fogadta el ezt a párosítási kódot. Semmi sem lett csatlakoztatva. Hozzon létre egy új kódot a vezérlőpultján, és próbálja újra."

#: includes/class-zinn-connector-claim.php:136
msgid "Connected. Zinn Digital® can now publish to this site."
msgstr "Kapcsolódva. A Zinn Digital® mostantól közzétehet ezen a webhelyen."

#. translators: %s: the Zinn Digital trade mark, which is not translated.
#: includes/class-zinn-connector-promo.php:241
#: includes/class-zinn-connector-promo.php:299
#, php-format
msgid "%s — guides and services"
msgstr "%s – útmutatók és szolgáltatások"

#: includes/class-zinn-connector-promo.php:256
msgid "User guides"
msgstr "Felhasználói útmutatók"

#. translators: %s: this plugin's name, e.g. "Zinn® Cache".
#: includes/class-zinn-connector-promo.php:306
#, php-format
msgid "Read the %s user guide"
msgstr "Olvassa el a(z) %s felhasználói útmutatót"

#: includes/class-zinn-connector-promo.php:314
msgid "Hide this"
msgstr "Elrejtés"

#: includes/class-zinn-connector-promo.php:374
msgid "Zinn® hosting for WordPress"
msgstr "Zinn® tárhely WordPresshez"

#: includes/class-zinn-connector-promo.php:375
msgid "LiteSpeed, daily backups, free migration and a control panel built for people who run more than one site."
msgstr "LiteSpeed, napi biztonsági mentések, ingyenes migráció és egy olyan vezérlőpult, amelyet egynél több webhelyet üzemeltetők számára terveztek."

#: includes/class-zinn-connector-promo.php:381
msgid "The Zinn® marketplace"
msgstr "A Zinn® piactér"

#: includes/class-zinn-connector-promo.php:382
msgid "Buy and sell established sites, domains and link placements, with the money held safely until both sides are happy."
msgstr "Vásároljon és adjon el meglévő webhelyeket, domaineket és linkelhelyezéseket úgy, hogy a pénzt biztonságban őrizzük, amíg mindkét fél elégedett nem lesz."

#: includes/class-zinn-connector-promo.php:429
msgid "Zinn Hub® — hire people who do this for a living"
msgstr "Zinn Hub® – béreljen szakembereket, akik ebből élnek"

#: includes/class-zinn-connector-promo.php:430
msgid "Our global freelance marketplace: browse over 10,000 ready-made services from writers, designers, developers and SEOs, or post a project and let them bid."
msgstr "Globális szabadúszó piacunk: böngésszen több mint 10 000 kész szolgáltatás között íróktól, tervezőktől, fejlesztőktől és SEO-szakemberektől, vagy tegyen közzé egy projektet, és hagyja, hogy ajánlatot tegyenek."

#. translators: %s: the WordPress username the credential belongs to.
#: includes/class-zinn-connector-settings.php:86
#, php-format
msgid "This site is connected to Zinn Digital®, publishing as %s."
msgstr "Ez a webhely csatlakozva van a Zinn Digital® hálózathoz, amely %s néven tesz közzé tartalmakat."

#. translators: %s: link to the WordPress profile screen.
#: includes/class-zinn-connector-settings.php:95
#, php-format
msgid "To disconnect, revoke the “Zinn Digital® (publishing)” application password on %s."
msgstr "A leválasztáshoz vonja vissza a(z) „Zinn Digital® (publishing)” alkalmazásjelszót itt: %s."

#: includes/class-zinn-connector-settings.php:96
msgid "your profile"
msgstr "az Ön profilja"

#: includes/class-zinn-connector-settings.php:102
#: includes/class-zinn-connector-settings.php:130
msgid "Connect this site"
msgstr "Webhely csatlakoztatása"

#: includes/class-zinn-connector-settings.php:104
msgid "Open your Zinn Digital® dashboard, go to Content → Other sites, and press “Get a pairing code”. Paste it below."
msgstr "Nyissa meg a Zinn Digital® vezérlőpultját, lépjen a Tartalom → Egyéb oldalak menüpontra, és kattintson a „Párosítási kód lekérése” gombra. Illessze be alább."

#: includes/class-zinn-connector-settings.php:112
msgid "Pairing code"
msgstr "Párosítási kód"

#: includes/class-zinn-connector-settings.php:125
msgid "It expires thirty minutes after you generate it, and can only be used once."
msgstr "Harminc perccel a generálás után lejár, és csak egyszer használható fel."

#: includes/class-zinn-connector-settings.php:153
msgid "You are not allowed to connect this site."
msgstr "Nem engedélyezett ennek a webhelynek a csatlakoztatása."

#: includes/class-zinn-connector-updater.php:233
msgid "See the Zinn Digital® release notes."
msgstr "Tekintse meg a Zinn Digital® kiadási megjegyzéseit."

#: includes/class-zinn-connector-updater.php:288
msgid "The downloaded update failed its integrity check and was not installed."
msgstr "A letöltött frissítés integritási ellenőrzése sikertelen volt, így nem lett a rendszerre telepítve."
