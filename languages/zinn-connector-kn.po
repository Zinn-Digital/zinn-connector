#: includes/class-zinn-connector-admin-fields.php:652
msgid "Nothing matches that filter."
msgstr "ಆ ಫಿಲ್ಟರ್‌ಗೆ ಯಾವುದೇ ಫಲಿತಾಂಶಗಳು ತಾಳೆಯಾಗುವುದಿಲ್ಲ."

#: includes/class-zinn-connector-admin-fields.php:683
