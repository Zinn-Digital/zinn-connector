msgstr "Bu fayl parametrlərin ixracı üçün həddindən artıq böyükdür."

#: includes/class-zinn-connector-admin-ui.php:1195
msgid "That file is not a Zinn® settings export."
msgstr "Bu fayl Zinn® parametrləri ixracı deyil."

